# Copy to apps/web/.env.local. Public values are embedded at build time.
# Empty public integration settings keep wallet/contract features unavailable.
NEXT_PUBLIC_APP_URL=
# celo or celo-sepolia; choosing a network requires an explicit HTTP(S) RPC URL.
NEXT_PUBLIC_NETWORK=
NEXT_PUBLIC_RPC_URL=
# Required for standard-web RainbowKit; not used by MiniPay.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Only verified deployments for the selected network. No defaults.
NEXT_PUBLIC_GD_ADDRESS=
NEXT_PUBLIC_SHOP_ADDRESS=
NEXT_PUBLIC_TOURNAMENT_ADDRESS=
# Future server adapters only; never prefix these with NEXT_PUBLIC_.
DATABASE_URL=
SESSION_SECRET=
RESULTS_SIGNER_PRIVATE_KEY=
